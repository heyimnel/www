---
import Layout from "../../layouts/Layout.astro";
import { projects } from "../../data/projects";

export const prerender = true;

const injectClass = (svg: string, className: string) => svg.replace('<svg', `<svg class="${className}"`);
---

<Layout>
    <div id="projects-container">
        <div class="projects-inner">
            <div class="projects-header">
                <a href="/" class="back-link">
                    <svg class="back-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 256 256"><path d="M224,128a8,8,0,0,1-8,8H59.31l58.35,58.34a8,8,0,0,1-11.32,11.32l-72-72a8,8,0,0,1,0-11.32l72-72a8,8,0,0,1,11.32,11.32L59.31,120H216A8,8,0,0,1,224,128Z"></path></svg>
                    Back home
                </a>
                <h1 class="projects-title">All Projects</h1>
            </div>

            <div class="projects-grid">
                {projects.map((project) => (
                    <a
                        href={project.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="project-card"
                    >
                        <div class="project-card-header">
                            <div class="project-icon-bg">
                                <Fragment set:html={injectClass(project.icon, 'project-icon')} />
                            </div>
                            <div class="project-info">
                                <h3 class="project-name">{project.title}</h3>
                                <div class="project-link-row">
                                    <svg class="caret-icon" xmlns="http://www.w3.org/2000/svg" width="10" height="10" fill="currentColor" viewBox="0 0 256 256"><path d="M181.66,133.66l-80,80a8,8,0,0,1-11.32-11.32L164.69,128,90.34,53.66a8,8,0,0,1,11.32-11.32l80,80A8,8,0,0,1,181.66,133.66Z"></path></svg>
                                    <span class="project-link-text">{project.linkText}</span>
                                </div>
                            </div>
                        </div>

                        <p class="project-description">
                            {project.description}
                        </p>
                    </a>
                ))}
            </div>
        </div>
    </div>
</Layout>
